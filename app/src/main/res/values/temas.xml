<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Diálogos no estilo PS4 (Temas e sons › Tela inicial › Estilo PS4). -->
    <style name="DialogoPs4" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/fundo_dialogo_ps4</item>
        <item name="android:colorBackground">#0B1A3C</item>
        <item name="android:colorAccent">#8FDAFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C8D4F0</item>
