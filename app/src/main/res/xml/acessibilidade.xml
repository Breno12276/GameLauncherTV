<?xml version="1.0" encoding="utf-8"?>
<!-- Serviço do botão PS e do menu rápido sem root: recebe os botões do controle de qualquer app, sabe qual app
     está na frente e pode capturar a tela. Não lê o conteúdo das telas (canRetrieveWindowContent = false). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:description="@string/acessibilidade_descricao"
    android:notificationTimeout="100" />
